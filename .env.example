# Copy via scripts/init-env.ps1 to generate unique local secrets.
POSTGRES_DB=auralis
POSTGRES_USER=auralis
POSTGRES_PASSWORD=GENERATE_WITH_INIT_SCRIPT
JWT_KEY=GENERATE_WITH_INIT_SCRIPT
# Optional Npgsql connection STRING, not a postgres:// URI.
# Blank means scripts/start-backend.ps1 builds it from POSTGRES_* above.
DATABASE_URL=
ASPNETCORE_URLS=http://localhost:5080
ASPNETCORE_ENVIRONMENT=Development
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4173
# Optional: enable YouTube Data API v3 in Google Cloud; restrict key appropriately.
# Never put this secret in a VITE_* variable.
YOUTUBE_API_KEY=
